# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=0
# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ── Case cache ───────────────────────────────────────────────────────────
# Minutes that live-scraped cases (and the eCourts session used for order PDFs) stay in memory
CASE_CACHE_TTL_MIN=30

# ── Rate limits (requests per window) ────────────────────────────────────
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_ECOURTS=10
RATE_LIMIT_ORDER=20

# ── AI order summaries (optional) ────────────────────────────────────────
# Without a key, live order summaries return 503 and demo orders use bundled sample summaries.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Override if Google retires the default model id
GEMINI_MODEL=gemini-2.5-flash

# ── Firestore persistence (optional) ─────────────────────────────────────
# Path to a Firebase service-account JSON. Leave empty for memory-only mode.
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=
